seed: 42
step_scheduler:
  log_remote_every_steps: 10
  num_epochs: 1
  global_batch_size: 32
  local_batch_size: 4
  max_steps: 2000
  ckpt_every_steps: 200
  val_every_steps: 200
dist_env:
  backend: nccl
  timeout_minutes: 60
peft:
  _target_: nemo_automodel.components._peft.lora.PeftConfig
  match_all_linear: false
  lora_dtype: torch.bfloat16
  target_modules:
  - '*self_attn.q_proj'
  - '*self_attn.k_proj'
  - '*self_attn.v_proj'
  - '*self_attn.o_proj'
  - '*.mlp.gate_proj'
  - '*.mlp.up_proj'
  - '*.mlp.down_proj'
  dim: 64
  alpha: 128
loss_fn:
  _target_: nemo_automodel.components.loss.masked_ce.MaskedCrossEntropy
checkpoint:
  enabled: true
  model_save_format: safetensors
  save_consolidated: false
  checkpoint_dir: /workspace/checkpoints/state_tracking/ar
distributed:
  strategy: fsdp2
  dp_size: null
  tp_size: 1
  cp_size: 1
  ep_size: 1
  sequence_parallel: false
  activation_checkpointing: true
  defer_fsdp_grad_sync: false
  mp_policy:
    param_dtype: bfloat16
    reduce_dtype: float32
    output_dtype: float32
  multimodal:
    frozen_sharding: per_layer
optimizer:
  _target_: torch.optim.AdamW
  eps: 1.0e-08
  lr: 0.00015
  betas:
  - 0.9
  - 0.95
  weight_decay: 0.01
clip_grad_norm:
  max_norm: 1.0
lr_scheduler:
  init_lr: 0.0
  lr_decay_style: cosine
  min_lr: 1.5e-05
  lr_warmup_steps: 60
dataset:
  _target_: nemo_automodel.components.datasets.llm.chat_dataset.ChatDataset
  split: train
  shuffle_seed: 42
  truncation: false
  mask_history: true
  tokenizer:
    _target_: transformers.AutoTokenizer.from_pretrained
    pretrained_model_name_or_path: google/gemma-4-26B-A4B-it
  padding: do_not_pad
  path_or_dataset_id: /workspace/alpha/dataset/state_tracking/train.jsonl
  seq_length: 1024
  chat_template: /workspace/alpha/src/common/gemma4_chat_template.jinja
recipe: FinetuneRecipeForVLM
rng:
  _target_: nemo_automodel.components.training.rng.StatefulRNG
  seed: 42
  ranked: true
model:
  _target_: nemo_automodel.NeMoAutoModelForImageTextToText.from_pretrained
  torch_dtype: torch.bfloat16
  trust_remote_code: true
  attn_implementation: sdpa
  backend:
    _target_: nemo_automodel.components.models.common.BackendConfig
    attn: te
    linear: te
    rms_norm: te
    dispatcher: torch
    fake_balanced_gate: false
    enable_hf_state_dict_adapter: true
    enable_fsdp_optimizations: true
  text_config:
    use_cache: false
  pretrained_model_name_or_path: google/gemma-4-26B-A4B-it
processor:
  padding_side: right
freeze_config:
  freeze_vision_tower: true
  freeze_audio_tower: true
  freeze_language_model: false
dataloader:
  _target_: torchdata.stateful_dataloader.StatefulDataLoader
  num_workers: 4
  persistent_workers: true
  pin_memory: true
  shuffle: true
  collate_fn:
    _target_: training.collate.padded
validation_dataloader:
  _target_: torchdata.stateful_dataloader.StatefulDataLoader
  num_workers: 4
  persistent_workers: true
  pin_memory: true
  shuffle: false
  collate_fn:
    _target_: training.collate.padded
validation_dataset:
  _target_: nemo_automodel.components.datasets.llm.chat_dataset.ChatDataset
  split: train
  shuffle_seed: 42
  truncation: false
  mask_history: true
  tokenizer:
    _target_: transformers.AutoTokenizer.from_pretrained
    pretrained_model_name_or_path: google/gemma-4-26B-A4B-it
  padding: do_not_pad
  path_or_dataset_id: /workspace/alpha/dataset/state_tracking/val.jsonl
  seq_length: 1024
  chat_template: /workspace/alpha/src/common/gemma4_chat_template.jinja
