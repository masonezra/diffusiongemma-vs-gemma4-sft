seed: 42
step_scheduler:
  log_remote_every_steps: 10
  num_epochs: 1
  global_batch_size: 32
  local_batch_size: 4
  max_steps: 2000
  ckpt_every_steps: 200
  val_every_steps: 200
dist_env:
  backend: nccl
  timeout_minutes: 60
peft:
  _target_: nemo_automodel.components._peft.lora.PeftConfig
  match_all_linear: false
  lora_dtype: torch.bfloat16
  target_modules:
  - '*self_attn.q_proj'
  - '*self_attn.k_proj'
  - '*self_attn.v_proj'
  - '*self_attn.o_proj'
  - '*.mlp.gate_proj'
  - '*.mlp.up_proj'
  - '*.mlp.down_proj'
  - '*self_conditioning.gate_proj'
  - '*self_conditioning.up_proj'
  - '*self_conditioning.down_proj'
  dim: 64
  alpha: 128
loss_fn:
  _target_: nemo_automodel.components.loss.masked_ce.MaskedCrossEntropy
checkpoint:
  enabled: true
  model_save_format: safetensors
  save_consolidated: false
  checkpoint_dir: /workspace/checkpoints/state_tracking/diffusion
distributed:
  strategy: fsdp2
  dp_size: null
  tp_size: 1
  cp_size: 1
  ep_size: 1
  sequence_parallel: false
  activation_checkpointing: true
  defer_fsdp_grad_sync: false
  mp_policy:
    param_dtype: bfloat16
    reduce_dtype: float32
    output_dtype: float32
  pp_size: 1
  autocast_dtype: bfloat16
  offload_policy: null
  moe:
    reshard_after_forward: false
optimizer:
  _target_: torch.optim.AdamW
  eps: 1.0e-08
  lr: 0.00015
  betas:
  - 0.95
  - 0.99
  weight_decay: 0.0001
clip_grad_norm:
  max_norm: 1.0
lr_scheduler:
  init_lr: 0.0
  lr_decay_style: cosine
  min_lr: 1.5e-05
  lr_warmup_steps: 60
dataset:
  _target_: nemo_automodel.components.datasets.llm.chat_dataset.ChatDataset
  split: train
  shuffle_seed: 42
  truncation: false
  mask_history: true
  unshifted: true
  tokenizer:
    pretrained_model_name_or_path: google/diffusiongemma-26B-A4B-it
  path_or_dataset_id: /workspace/alpha/dataset/state_tracking/train.jsonl
  seq_length: 1024
  chat_template: /workspace/alpha/src/common/diffusion_gemma_chat_template.jinja
recipe: DiffusionGemmaSFTRecipe
model:
  _target_: nemo_automodel.NeMoAutoModelForCausalLM.from_pretrained
  torch_dtype: bfloat16
  canvas_length: 256
  self_conditioning: true
  freeze_router: true
  backend:
    _target_: nemo_automodel.components.models.common.BackendConfig
    attn: sdpa
    linear: torch
    rms_norm: torch_fp32
    experts: torch_mm
    dispatcher: torch
    enable_hf_state_dict_adapter: true
    enable_fsdp_optimizations: true
  pretrained_model_name_or_path: google/diffusiongemma-26B-A4B-it
  _restore_loaded_dtype: false
dllm:
  mode: block_diffusion
  block_size: 256
  vocab_size: 262144
  eps: 0.001
  pad_block_size: 256
  pad_seq_len_divisible: 256
  encoder_loss_weight: 0.0
  self_conditioning_p: 0.5
  mask_token_id: 0
dataloader:
  _target_: torchdata.stateful_dataloader.StatefulDataLoader
  collate_fn: nemo_automodel.components.datasets.utils.default_collater
  shuffle: true
validation_dataloader:
  _target_: torchdata.stateful_dataloader.StatefulDataLoader
  collate_fn: nemo_automodel.components.datasets.utils.default_collater
  shuffle: false
validation_dataset:
  _target_: nemo_automodel.components.datasets.llm.chat_dataset.ChatDataset
  split: train
  shuffle_seed: 42
  truncation: false
  mask_history: true
  unshifted: true
  tokenizer:
    pretrained_model_name_or_path: google/diffusiongemma-26B-A4B-it
  path_or_dataset_id: /workspace/alpha/dataset/state_tracking/val.jsonl
  seq_length: 1024
  chat_template: /workspace/alpha/src/common/diffusion_gemma_chat_template.jinja
